+
+test('the iOS app signs in with Google by redeeming a one-time code it alone can prove',async()=>{
+  const {createHash}=await import('node:crypto');
+  const f=fixture();const handoffs=new Map();
+  Object.assign(f.store,{
+    saveAppHandoff:async(hash,id,challenge)=>handoffs.set(hash,{learner_id:id,challenge}),
+    consumeAppHandoff:async hash=>{const h=handoffs.get(hash);handoffs.delete(hash);return h},
+    learnerById:async id=>({id,name:'Nadia',email:'nadia@example.com',google_sub:'google-id',password_hash:null}),
+    progress:async()=>null,
+  });
+  const verifier='v'.repeat(43), challenge=createHash('sha256').update(verifier).digest('base64url');
+  assert.equal((await invoke(f.app,'/api/learn/google/start?app=1&challenge=short')).status,400);
+  assert.equal((await invoke(f.app,'/api/learn/auth-options')).body.app,true);
+  const start=await invoke(f.app,'/api/learn/google/start?app=1&challenge='+challenge);
+  assert.equal(start.status,302);assert.equal(start.headers['set-cookie'].length,2);
+  const cookies=start.headers['set-cookie'].map(c=>c.split(';')[0]).join('; ');
+  const done=await invoke(f.app,'/api/learn/google/callback?code=code&state='+f.authorization.state,cookies);
+  // The browser sheet is sent back to the app with a code, and is given no session of its own.
+  assert.match(done.headers.location,/^loba:\/\/auth\?code=[A-Za-z0-9_-]{43}$/);
+  assert.ok(done.headers['set-cookie'].every(c=>!c.includes('loba_learner')));assert.equal(f.sessions.size,0);
+  const code=done.headers.location.split('code=')[1];
+  // Without the verifier the code is useless, and it is spent by the attempt.
+  assert.equal((await invoke(f.app,'/api/learn/google/redeem','','POST',{code,verifier:'wrong'})).status,401);
+  assert.equal((await invoke(f.app,'/api/learn/google/redeem','','POST',{code,verifier})).status,401);
+  const again=await invoke(f.app,'/api/learn/google/start?app=1&challenge='+challenge);
+  const next=await invoke(f.app,'/api/learn/google/callback?code=code&state='+f.authorization.state,again.headers['set-cookie'].map(c=>c.split(';')[0]).join('; '));
+  const ok=await invoke(f.app,'/api/learn/google/redeem','','POST',{code:next.headers.location.split('code=')[1],verifier});
+  assert.equal(ok.status,200);assert.equal(ok.body.learner.email,'nadia@example.com');assert.equal(ok.body.learner.googleLinked,true);
+  assert.match(ok.headers['set-cookie'][1],/^__Host-loba_learner=/);assert.equal(f.sessions.size,1);
+  // A refused sign-in also returns to the app, with the reason.
+  const denied=await invoke(f.app,'/api/learn/google/start?app=1&challenge='+challenge);
+  const refused=await invoke(f.app,'/api/learn/google/callback?error=access_denied&state='+f.authorization.state,denied.headers['set-cookie'].map(c=>c.split(';')[0]).join('; '));
+  assert.equal(refused.headers.location,'loba://auth?error=google_cancelled');
+});
